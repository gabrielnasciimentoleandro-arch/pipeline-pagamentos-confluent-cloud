# .env.example — modelo das variáveis. Copie para .env e preencha.
# O arquivo .env está no .gitignore: NUNCA versione chaves reais.

# Confluent Cloud (IDs, gerados pelo scripts/01_fundacao.sh)
ENV_ID=
CLUSTER_ID=
COMPUTE_POOL_ID=
SA_PRODUTOR=
SA_LEITOR=
CONNECTOR_ID=

# Kafka: identidade de LEITURA (service account sa-leitor)
BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Schema Registry (identidade de LEITURA)
SR_URL=
SR_API_KEY=
SR_API_SECRET=

# Postgres de origem
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
PGHOST=
PGPORT=5432
PGDATABASE=pagamentos
PGUSER=
PGPASSWORD=
